@model FincaNovaGestionLotes.Web.Areas.Produccion.Models.PeriodoCrearViewModel

@{
    ViewData["Title"] = "Nuevo período productivo";
}

<div class="fn-page-header">

    <div>

        <h1 class="fn-page-title">
            Nuevo período productivo
        </h1>

        <p class="fn-page-subtitle">
            Registra un período productivo y asigna las fincas y lotes que participan.
        </p>

    </div>

    <div>

        <a asp-action="Index"
           class="fn-btn fn-btn-outline">
            Volver
        </a>

    </div>

</div>


<div class="fn-card">

    <div class="fn-card-body">

        <form asp-action="Crear"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-3">

                <label asp-for="Nombre"
                       class="fn-form-label">
                </label>

                <input asp-for="Nombre"
                       class="fn-form-control"
                       placeholder="Ej. Cosecha 2026-2027" />

                <span asp-validation-for="Nombre"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="FechaInicio"
                       class="fn-form-label">
                </label>

                <input asp-for="FechaInicio"
                       type="date"
                       class="fn-form-control" />

                <span asp-validation-for="FechaInicio"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="FechaFin"
                       class="fn-form-label">
                </label>

                <input asp-for="FechaFin"
                       type="date"
                       class="fn-form-control" />

                <span asp-validation-for="FechaFin"
                      class="text-danger">
                </span>

                <div class="form-text">
                    Puedes dejarla vacía si el período continúa abierto.
                </div>

            </div>


            <div class="mb-3">

                <label asp-for="Observaciones"
                       class="fn-form-label">
                </label>

                <textarea asp-for="Observaciones"
                          class="fn-form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Observaciones"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">
                <partial name="_TerrenosSeleccion" model="(Model.Terrenos, Model.TerrenoIds)" />
            </div>


            <div class="d-flex gap-2">

                <button type="submit"
                        class="fn-btn fn-btn-primary">
                    Registrar período
                </button>

                <a asp-action="Index"
                   class="fn-btn fn-btn-outline">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}