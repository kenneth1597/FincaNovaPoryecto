@model IEnumerable<FincaNovaGestionLotes.Web.Domain.Produccion.PeriodoProductivo>

@{
    ViewData["Title"] = "Períodos productivos";
}

<div class="fn-page-header">

    <div>

        <h1 class="fn-page-title">

            <span class="fn-page-title-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M7 3v4M17 3v4M3 10h18" />
                </svg>
            </span>

            Períodos productivos

        </h1>

        <p class="fn-page-subtitle">
            Administración de los períodos productivos asociados a cada lote.
        </p>

    </div>

    <a asp-action="Crear"
       class="fn-btn fn-btn-primary">
        + Nuevo período
    </a>

</div>


@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success border-0 shadow-sm">
        @ok
    </div>
}


<div class="fn-card">

    <div class="fn-card-header d-flex justify-content-between align-items-center">

        <h2 class="fn-card-title">
            Períodos registrados
        </h2>

        <span class="fn-count">
            @Model.Count() período(s)
        </span>

    </div>


    @if (!Model.Any())
    {
        <div class="fn-empty">

            <div class="fn-empty-title">
                No existen períodos productivos registrados.
            </div>

            <div class="fn-empty-text">
                Registra el primer período para comenzar.
            </div>

        </div>
    }
    else
    {

        <div class="fn-card-body">

            <div class="fn-table-wrapper">

                <table class="fn-table">

                    <thead>

                        <tr>
                            <th>Lote</th>
                            <th>Fecha de inicio</th>
                            <th>Fecha de finalización</th>
                            <th>Estado</th>
                            <th>Observaciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var periodo in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @periodo.Lote.Codigo
                                    </strong>

                                    <div class="small text-muted">
                                        @periodo.Lote.Nombre
                                    </div>

                                </td>

                                <td>
                                    @periodo.FechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (periodo.FechaFin.HasValue)
                                    {
                                        @periodo.FechaFin.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            En curso
                                        </span>
                                    }
                                </td>

                                <td>

                                    @if (periodo.Cerrado)
                                    {
                                        <span class="fn-badge fn-badge-neutral">
                                            <span class="fn-status-dot fn-status-closed"></span>
                                            Cerrado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fn-badge fn-badge-success">
                                            <span class="fn-status-dot fn-status-open"></span>
                                            Abierto
                                        </span>
                                    }

                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(periodo.Observaciones)
                                        ? "—"
                                        : periodo.Observaciones)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    }

</div>