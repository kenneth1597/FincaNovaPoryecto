@model (IEnumerable<FincaNovaGestionLotes.Web.Areas.Produccion.Models.TerrenoOpcionViewModel> Terrenos, List<int> Seleccionados)

@* Casillas de fincas y lotes; los lotes aparecen sangrados bajo su finca. *@
<label class="fn-form-label">Fincas y lotes</label>

@if (!Model.Terrenos.Any())
{
    <div class="alert alert-warning mb-0">
        No hay fincas ni lotes registrados.
        <a asp-area="Terrenos" asp-controller="Terrenos" asp-action="Index">Ir a fincas y lotes</a>
    </div>
}
else
{
    <div class="form-text mb-2">
        Marca las fincas y lotes que participan en este período. Los que no marques quedan fuera.
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-2">
        @foreach (var t in Model.Terrenos)
        {
            <div class="col">
                <div class="form-check @(t.Tipo == TipoTerreno.Lote ? "ms-4" : "")">
                    <input class="form-check-input" type="checkbox" name="TerrenoIds"
                           id="ter-@t.Id" value="@t.Id"
                           checked="@Model.Seleccionados.Contains(t.Id)" />
                    <label class="form-check-label" for="ter-@t.Id">
                        @if (t.Tipo == TipoTerreno.Finca)
                        {
                            <strong>@t.Texto</strong>
                        }
                        else
                        {
                            @t.Texto
                        }
                    </label>
                </div>
            </div>
        }
    </div>
}

@Html.ValidationMessage("TerrenoIds", new { @class = "text-danger d-block mt-1" })
