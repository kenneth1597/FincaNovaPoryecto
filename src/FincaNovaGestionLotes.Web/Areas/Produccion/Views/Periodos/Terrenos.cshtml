@model FincaNovaGestionLotes.Web.Areas.Produccion.Models.PeriodoAsignarTerrenosViewModel

@{
    ViewData["Title"] = "Fincas y lotes del período";
}

<div class="fn-page-header">

    <div>

        <h1 class="fn-page-title">
            @Model.Nombre
        </h1>

        <p class="fn-page-subtitle">
            Del @Model.FechaInicio.ToString("dd/MM/yyyy")
            @(Model.FechaFin.HasValue ? $"al {Model.FechaFin.Value:dd/MM/yyyy}" : "· en curso").
            Marca las fincas y lotes que participan en este período.
        </p>

    </div>

    <div>

        <a asp-action="Index"
           class="fn-btn fn-btn-outline">
            Volver
        </a>

    </div>

</div>


<div class="fn-card">

    <div class="fn-card-body">

        <form asp-action="Terrenos"
              method="post">

            <input type="hidden" asp-for="PeriodoId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-3">
                <partial name="_TerrenosSeleccion" model="(Model.Terrenos, Model.TerrenoIds)" />
            </div>


            <div class="d-flex gap-2">

                <button type="submit"
                        class="fn-btn fn-btn-primary">
                    Guardar asignación
                </button>

                <a asp-action="Index"
                   class="fn-btn fn-btn-outline">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>
