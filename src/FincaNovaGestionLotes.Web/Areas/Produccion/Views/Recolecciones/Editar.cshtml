@model FincaNovaGestionLotes.Web.Domain.Produccion.Recoleccion

@{
    ViewData["Title"] = "Editar Recolección";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Editar Recolección Diaria</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Recolecciones</a></li>
        <li class="breadcrumb-item active">Editar Registro</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-edit me-1"></i> Modificar Datos de Recolección
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>


                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="KgPorCajuela" />
                <input type="hidden" asp-for="RegistradoPor" /> 
                <input type="hidden" asp-for="FechaCreacion" />

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label asp-for="ColaboradorId" class="form-label">Colaborador</label>
                        <select asp-for="ColaboradorId" class="form-select" asp-items="ViewBag.Colaboradores">
                            <option value="">-- Seleccione un colaborador --</option>
                        </select>
                        <span asp-validation-for="ColaboradorId" class="text-danger"></span>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label asp-for="TerrenoId" class="form-label">Lote / Terreno</label>
                        <select asp-for="TerrenoId" class="form-select" asp-items="ViewBag.Terrenos">
                            <option value="">-- Seleccione un lote --</option>
                        </select>
                        <span asp-validation-for="TerrenoId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label asp-for="PeriodoProductivoId" class="form-label">Período Productivo</label>
                        <select asp-for="PeriodoProductivoId" class="form-select" asp-items="ViewBag.PeriodosProductivos">
                            <option value="">-- Seleccione el período --</option>
                        </select>
                        <span asp-validation-for="PeriodoProductivoId" class="text-danger"></span>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label asp-for="Fecha" class="form-label">Fecha de Recolección</label>
                        <input asp-for="Fecha" class="form-control" type="date" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label asp-for="Cajuelas" class="form-label">Cantidad (Cajuelas)</label>
                        <input asp-for="Cajuelas" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Cajuelas" class="text-danger"></span>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label asp-for="Observaciones" class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}