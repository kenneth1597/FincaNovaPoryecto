@model IEnumerable<FincaNovaGestionLotes.Web.Domain.Produccion.Recoleccion>

@{
    ViewData["Title"] = "Listado de Recolecciones";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Control de Recolecciones</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Producción y Recolección Diaria</li>
    </ol>

    <div class="mb-3">
        <a asp-action="Crear" class="btn btn-success"><i class="fas fa-plus"></i> Registrar Nueva Recolección</a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i> Historial de Recolecciones Registradas
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Colaborador</th>
                        <th>Lote</th>
                        <th>Cajuelas</th>
                        <th>Peso Estimado (Kg)</th>
                        <th>Registrado Por</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@item.Colaborador?.Nombre</td>
                                <td>@item.Terreno?.Nombre</td>
                                <td>@item.Cajuelas.ToString("N2")</td>
                                <td><strong>@item.PesoEstimadoKg.ToString("N2") kg</strong></td>
                                <td>@item.RegistradoPor</td>
                                <td>
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No hay registros de recolección guardados todavía.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>