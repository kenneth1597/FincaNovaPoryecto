@model IEnumerable<Recoleccion>

@{
    ViewData["Title"] = "Recolecciones";
}

<div class="fn-page-header">
    <div>
        <h1 class="fn-page-title">Control de recolecciones</h1>
        <p class="fn-page-subtitle">
            Producción diaria en cajuelas por colaborador y lote, con el peso estimado en kilogramos.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ConsultaPeriodo" class="fn-btn fn-btn-outline">Total por período</a>
        <a asp-action="CalcularPagos" class="fn-btn fn-btn-outline">Calcular pago a trabajadores</a>
        <a asp-action="Crear" class="fn-btn fn-btn-primary">+ Registrar recolección</a>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success border-0 shadow-sm">@ok</div>
}

<div class="fn-card">
    <div class="fn-card-header d-flex justify-content-between align-items-center">
        <h2 class="fn-card-title">Historial de recolecciones</h2>
        <span class="fn-count">@Model.Count() registro(s)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty">
            <div class="fn-empty-title">No hay recolecciones registradas.</div>
            <div class="fn-empty-text">Registra la primera recolección para empezar a llevar la producción diaria.</div>
        </div>
    }
    else
    {
        <div class="fn-card-body">
            <div class="fn-table-wrapper">
                <table class="fn-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Colaborador</th>
                            <th>Lote</th>
                            <th>Período</th>
                            <th class="text-end">Cajuelas</th>
                            <th class="text-end">Peso estimado</th>
                            <th>Registrado por</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold">@item.Colaborador?.Nombre</td>
                                <td>@item.Terreno?.Nombre</td>
                                <td>@item.PeriodoProductivo?.Nombre</td>
                                <td class="text-end">@item.Cajuelas.ToString("N2")</td>
                                <td class="text-end fw-bold">@item.PesoEstimadoKg.ToString("N2") kg</td>
                                <td>@(item.RegistradoPor ?? "—")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="fn-btn fn-btn-outline">Editar</a>
                                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="fn-btn fn-btn-outline">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
