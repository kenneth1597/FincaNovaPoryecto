@model Recoleccion

@{
    ViewData["Title"] = "Eliminar recolección";
}

<div class="fn-page-header">
    <div>
        <h1 class="fn-page-title">Eliminar recolección</h1>
        <p class="fn-page-subtitle">Revisa los datos antes de confirmar. Esta acción no se puede deshacer.</p>
    </div>
    <a asp-action="Index" class="fn-btn fn-btn-outline">Volver</a>
</div>

<div class="fn-card">
    <div class="fn-card-body">
        <div class="alert alert-danger border-0 shadow-sm">
            <strong>¿Seguro que quieres eliminar este registro?</strong>
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-3">Fecha</dt>
            <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Colaborador</dt>
            <dd class="col-sm-9">@Model.Colaborador?.Nombre</dd>

            <dt class="col-sm-3">Lote / terreno</dt>
            <dd class="col-sm-9">@Model.Terreno?.Nombre</dd>

            <dt class="col-sm-3">Período</dt>
            <dd class="col-sm-9">@Model.PeriodoProductivo?.Nombre</dd>

            <dt class="col-sm-3">Cajuelas</dt>
            <dd class="col-sm-9">@Model.Cajuelas.ToString("N2")</dd>

            <dt class="col-sm-3">Peso estimado</dt>
            <dd class="col-sm-9">@Model.PesoEstimadoKg.ToString("N2") kg</dd>
        </dl>

        <form asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="fn-btn fn-btn-primary">Sí, eliminar</button>
                <a asp-action="Index" class="fn-btn fn-btn-outline">Cancelar</a>
            </div>
        </form>
    </div>
</div>
