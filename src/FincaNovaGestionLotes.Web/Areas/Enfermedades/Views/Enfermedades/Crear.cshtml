@model FincaNovaGestionLotes.Web.Areas.Enfermedades.Models.EnfermedadCrearViewModel

@{
    ViewData["Title"] = "Registrar enfermedad";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Registrar enfermedad</h1>
        <p class="text-muted mb-0">
            Registre una enfermedad encontrada en un lote.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Volver
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Crear" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="LoteId" class="form-label"></label>

                <select asp-for="LoteId"
                        class="form-select">

                    <option value="">
                        -- Seleccione un lote --
                    </option>

                    @foreach (var lote in Model.Lotes)
                    {
                        <option value="@lote.Id">
                            @lote.Texto
                        </option>
                    }

                </select>

                <span asp-validation-for="LoteId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>

                <input asp-for="Nombre"
                       class="form-control" />

                <span asp-validation-for="Nombre"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaDeteccion"
                       class="form-label"></label>

                <input asp-for="FechaDeteccion"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="FechaDeteccion"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Severidad"
                       class="form-label"></label>

                <select asp-for="Severidad"
                        class="form-select">

                    <option value="">
                        -- Seleccione --
                    </option>

                    <option value="Leve">Leve</option>
                    <option value="Moderada">Moderada</option>
                    <option value="Grave">Grave</option>

                </select>

                <span asp-validation-for="Severidad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion"
                       class="form-label"></label>

                <textarea asp-for="Descripcion"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Descripcion"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones"
                       class="form-label"></label>

                <textarea asp-for="Observaciones"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Registrar enfermedad
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}