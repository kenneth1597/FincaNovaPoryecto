@model FincaNovaGestionLotes.Web.Areas.Enfermedades.Models.TratamientoCrearViewModel

@{
    ViewData["Title"] = "Registrar tratamiento";
}

<h1>Registrar tratamiento</h1>

<p class="text-muted">
    Registre el tratamiento aplicado y los productos utilizados.
</p>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="CrearTratamiento"
              method="post">

            <input type="hidden"
                   asp-for="EnfermedadId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Tratamiento"
                       class="form-label"></label>

                <textarea asp-for="Tratamiento"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Tratamiento"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaAplicacion"
                       class="form-label"></label>

                <input asp-for="FechaAplicacion"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="FechaAplicacion"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Responsable"
                       class="form-label"></label>

                <input asp-for="Responsable"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Resultado"
                       class="form-label"></label>

                <textarea asp-for="Resultado"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Efectividad"
                       class="form-label"></label>

                <select asp-for="Efectividad"
                        class="form-select">
                    <option value="">-- ¿Cómo respondió la enfermedad? --</option>
                    @foreach (EfectividadTratamiento e in Enum.GetValues<EfectividadTratamiento>())
                    {
                        <option value="@e">@Ui.EfectividadTexto(e)</option>
                    }
                </select>

                <span asp-validation-for="Efectividad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones"
                       class="form-label"></label>

                <textarea asp-for="Observaciones"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <hr />

            <h4>Productos utilizados</h4>

            <p class="text-muted">
                Registre los productos utilizados durante el tratamiento. Si el producto está en el
                inventario, selecciónelo y la cantidad se rebajará automáticamente de las existencias.
            </p>

            <span asp-validation-for="Productos" class="text-danger"></span>

            <div id="productos">

                @for (int i = 0; i < Model.Productos.Count; i++)
                {
                    var p = Model.Productos[i];
                    <div class="row g-2 mb-2 producto">

                        <div class="col-md-4">
                            <select name="Productos[@i].InsumoId" class="form-select insumo">
                                <option value="">Otro producto (no está en el inventario)</option>
                                @foreach (var ins in Model.Insumos)
                                {
                                    <option value="@ins.Id" data-unidad="@ins.Unidad"
                                            selected="@(p.InsumoId == ins.Id)">
                                        @ins.Nombre — hay @Ui.CantidadConUnidad(ins.StockActual, ins.Unidad)
                                    </option>
                                }
                            </select>
                            <span class="text-danger small">@Html.ValidationMessage($"Productos[{i}].InsumoId")</span>
                        </div>

                        <div class="col-md-3">
                            <input name="Productos[@i].NombreProducto" value="@p.NombreProducto"
                                   class="form-control nombre"
                                   placeholder="Nombre del producto" />
                            <span class="text-danger small">@Html.ValidationMessage($"Productos[{i}].NombreProducto")</span>
                        </div>

                        <div class="col-md-2">
                            <input name="Productos[@i].Cantidad" value="@(p.Cantidad == 0 ? "" : p.Cantidad.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   placeholder="Cantidad" />
                            <span class="text-danger small">@Html.ValidationMessage($"Productos[{i}].Cantidad")</span>
                        </div>

                        <div class="col-md-2">
                            <input name="Productos[@i].Unidad" value="@p.Unidad"
                                   class="form-control unidad"
                                   placeholder="Unidad" />
                            <span class="text-danger small">@Html.ValidationMessage($"Productos[{i}].Unidad")</span>
                        </div>

                        <div class="col-md-1">
                            <button type="button" class="btn btn-outline-secondary w-100 quitar" title="Quitar producto">✕</button>
                        </div>

                    </div>
                }

            </div>

            <button type="button" class="btn btn-outline-secondary btn-sm" id="agregarProducto">
                + Agregar producto
            </button>

            <button type="submit"
                    class="btn btn-success mt-3">
                Registrar tratamiento
            </button>

            <a asp-action="Detalle"
               asp-route-id="@Model.EnfermedadId"
               class="btn btn-outline-secondary mt-3">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const contenedor = document.getElementById('productos');

            // Con un insumo del inventario, el nombre y la unidad salen del insumo.
            function sincronizar(fila) {
                const opcion = fila.querySelector('.insumo').selectedOptions[0];
                const delInventario = !!opcion.value;
                const nombre = fila.querySelector('.nombre');
                const unidad = fila.querySelector('.unidad');
                nombre.readOnly = unidad.readOnly = delInventario;
                if (delInventario) {
                    nombre.value = opcion.textContent.split(' — ')[0].trim();
                    unidad.value = opcion.dataset.unidad;
                }
            }

            // Los nombres de campo deben quedar Productos[0], Productos[1]... sin huecos.
            function renumerar() {
                contenedor.querySelectorAll('.producto').forEach((fila, i) =>
                    fila.querySelectorAll('[name]').forEach(el =>
                        el.name = el.name.replace(/Productos\[\d+\]/, `Productos[${i}]`)));
            }

            contenedor.addEventListener('change', e => {
                if (e.target.classList.contains('insumo')) sincronizar(e.target.closest('.producto'));
            });

            contenedor.addEventListener('click', e => {
                if (!e.target.classList.contains('quitar')) return;
                if (contenedor.querySelectorAll('.producto').length === 1) return;
                e.target.closest('.producto').remove();
                renumerar();
            });

            document.getElementById('agregarProducto').addEventListener('click', () => {
                const nueva = contenedor.querySelector('.producto').cloneNode(true);
                nueva.querySelectorAll('input').forEach(el => { el.value = ''; el.readOnly = false; });
                nueva.querySelector('.insumo').value = '';
                nueva.querySelectorAll('.text-danger').forEach(el => el.textContent = '');
                contenedor.appendChild(nueva);
                renumerar();
            });

            contenedor.querySelectorAll('.producto').forEach(sincronizar);
        })();
    </script>
}