@model TerrenoDetalleViewModel
@{
    var terreno = Model.Terreno;
    var esFinca = terreno.Tipo == TipoTerreno.Finca;
    var tipoTexto = Ui.TipoTerrenoTexto(terreno.Tipo);
    var conArticulo = Ui.TipoTerrenoConArticulo(terreno.Tipo);
    var g = Ui.TerminacionGenero(terreno.Tipo);
    ViewData["Title"] = $"{terreno.Codigo} — {terreno.Nombre}";
}

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="fn-page-header">
    <div>
        <h1 class="fn-page-title">
            @terreno.Codigo — @terreno.Nombre
        </h1>
        <p class="fn-page-subtitle mb-0">
            <span class="badge bg-@Ui.EstadoTerrenoColor(terreno.Estado)">@Ui.EstadoTerrenoTexto(terreno.Estado)</span>
            <span class="fn-badge @(esFinca ? "fn-badge-info" : "fn-badge-neutral") ms-1">@tipoTexto</span>
            @if (!esFinca && terreno.FincaPadre is not null)
            {
                <a asp-action="Detalle" asp-route-id="@terreno.FincaPadreId" class="small ms-2">
                    Pertenece a la finca @terreno.FincaPadre.Codigo — @terreno.FincaPadre.Nombre
                </a>
            }
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="fn-btn fn-btn-outline">Volver al listado</a>
        <a asp-action="Editar" asp-route-id="@terreno.Id" class="fn-btn fn-btn-outline">Editar</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">Ficha técnica</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Área</dt><dd class="col-sm-8">@terreno.AreaHectareas.ToString("N2") ha</dd>
                    <dt class="col-sm-4">Variedad de café</dt><dd class="col-sm-8">@(terreno.VariedadCafe ?? "—")</dd>
                    <dt class="col-sm-4">Año de siembra</dt><dd class="col-sm-8">@(terreno.AnioSiembra?.ToString() ?? "—")</dd>
                    <dt class="col-sm-4">Ubicación</dt><dd class="col-sm-8">@(terreno.Ubicacion ?? "—")</dd>
                    <dt class="col-sm-4">Observaciones</dt><dd class="col-sm-8">@(terreno.Observaciones ?? "—")</dd>
                    <dt class="col-sm-4">Registrad@(g)</dt><dd class="col-sm-8">@terreno.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Último cambio de estado</dt>
                    <dd class="col-sm-8">
                        @(terreno.FechaUltimoCambioEstado?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                        @if (!string.IsNullOrEmpty(terreno.EstadoCambiadoPor))
                        {
                            <span class="text-muted">por @terreno.EstadoCambiadoPor</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Estado operativo</div>
            <div class="card-body">
                <form asp-action="CambiarEstado" method="post" class="d-flex gap-2 mb-3">
                    <input type="hidden" name="id" value="@terreno.Id" />
                    <select name="estado" class="form-select">
                        @foreach (EstadoTerreno e in Enum.GetValues<EstadoTerreno>())
                        {
                            if (e == terreno.Estado || e == EstadoTerreno.Inactivo) { continue; }
                            <option value="@e">@Ui.EstadoTerrenoTexto(e)</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-success text-nowrap">Cambiar estado</button>
                </form>

                <hr />

                <button type="button" class="btn btn-outline-warning w-100 mb-2" data-bs-toggle="modal" data-bs-target="#modalDesactivar">Desactivar</button>
                <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#modalEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@if (esFinca)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Lotes de la finca @terreno.Codigo</span>
            @if (terreno.Estado != EstadoTerreno.Inactivo && Model.AreaDisponible > 0)
            {
                <a asp-action="Crear" asp-route-tipo="Lote" asp-route-padreId="@terreno.Id" class="btn btn-sm btn-outline-success">+ Nuevo lote</a>
            }
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between small mb-1">
                <span>
                    Área asignada a lotes: <strong>@Model.AreaAsignada.ToString("N2") ha</strong>
                    de @terreno.AreaHectareas.ToString("N2") ha
                </span>
                <span class="text-muted">Disponible: @Model.AreaDisponible.ToString("N2") ha</span>
            </div>
            <div class="fn-area-barra @(Model.AreaDisponible <= 0 ? "llena" : "") mb-3" role="progressbar"
                 aria-valuenow="@Model.PorcentajeAsignado" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Área asignada a lotes">
                <span style="width: @Model.PorcentajeAsignado%"></span>
            </div>
            @if (Model.AreaDisponible <= 0)
            {
                <div class="alert alert-warning py-2 small">
                    Toda el área de la finca ya está asignada. Para crear otro lote, reduzca el área de un lote existente o aumente el área de la finca.
                </div>
            }

            @if (!Model.Lotes.Any())
            {
                <p class="text-muted mb-0">Esta finca todavía no tiene lotes registrados.</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Ubicación</th><th>Área (ha)</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var l in Model.Lotes)
                        {
                            <tr>
                                <td>@l.Codigo</td>
                                <td>@l.Nombre</td>
                                <td>@(l.Ubicacion ?? "—")</td>
                                <td>@l.AreaHectareas.ToString("N2")</td>
                                <td><span class="badge bg-@Ui.EstadoTerrenoColor(l.Estado)">@Ui.EstadoTerrenoTexto(l.Estado)</span></td>
                                <td class="text-end"><a asp-action="Detalle" asp-route-id="@l.Id" class="btn btn-sm btn-outline-secondary">Ver</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Indicadores de mantenimiento</span>
        @if (Model.IncluyeLotes)
        {
            <span class="small text-muted">Incluye las labores de los lotes de esta finca</span>
        }
    </div>
    <div class="card-body">
        @if (!Model.Indicadores.Any())
        {
            <p class="text-muted mb-0">Todavía no hay horas de trabajo registradas.</p>
        }
        else
        {
            var totalHoras = Model.Indicadores.Sum(i => i.Horas);
            var totalJornadas = Model.Indicadores.Sum(i => i.Jornadas);
            var totalCosto = Model.Indicadores.Sum(i => i.Costo);

            <div class="row row-cols-1 row-cols-md-3 g-2 mb-3">
                <div class="col">
                    <div class="card text-center"><div class="card-body py-2">
                        <div class="fs-4 fw-bold">@totalHoras.ToString("N2")</div>
                        <div class="small text-muted">Horas trabajadas</div>
                    </div></div>
                </div>
                <div class="col">
                    <div class="card text-center"><div class="card-body py-2">
                        <div class="fs-4 fw-bold">@totalJornadas.ToString("N2")</div>
                        <div class="small text-muted">Jornadas (@Model.HorasPorJornada.ToString("0.##") h)</div>
                    </div></div>
                </div>
                <div class="col">
                    <div class="card text-center"><div class="card-body py-2">
                        <div class="fs-4 fw-bold">₡@totalCosto.ToString("N0")</div>
                        <div class="small text-muted">Costo operativo</div>
                    </div></div>
                </div>
            </div>

            <table class="table table-sm mb-0">
                <thead><tr><th>Labor</th><th class="text-end">Registros</th><th class="text-end">Horas</th><th class="text-end">Jornadas</th><th class="text-end">Costo</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Indicadores)
                    {
                        <tr>
                            <td>@Ui.TipoLaborTexto(i.Tipo)</td>
                            <td class="text-end">@i.Labores</td>
                            <td class="text-end">@i.Horas.ToString("N2")</td>
                            <td class="text-end">@i.Jornadas.ToString("N2")</td>
                            <td class="text-end">₡@i.Costo.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Bitácora de labores de @terreno.Codigo</span>
        <div class="d-flex gap-2">
            <a asp-area="Labores" asp-controller="Labores" asp-action="Index" asp-route-terrenoId="@terreno.Id" class="btn btn-sm btn-outline-secondary">Ver bitácora completa</a>
            @if (terreno.Estado != EstadoTerreno.Inactivo)
            {
                <a asp-area="Labores" asp-controller="Labores" asp-action="Crear" asp-route-terrenoId="@terreno.Id" class="btn btn-sm btn-outline-success">+ Registrar labor</a>
            }
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Labores.Any())
        {
            <p class="text-muted mb-0">@(esFinca ? "Esta finca" : "Este lote") todavía no tiene labores registradas.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Fecha</th><th>Labor</th><th>Horas</th><th>Estado</th><th>Colaboradores</th><th>Observaciones</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Labores.Take(10))
                    {
                        <tr>
                            <td>@l.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@Ui.TipoLaborTexto(l.Tipo)</td>
                            <td>@l.HorasTotales.ToString("N2")</td>
                            <td><span class="fn-badge @Ui.EstadoLaborBadge(l.Estado)">@Ui.EstadoLaborTexto(l.Estado)</span></td>
                            <td>@string.Join(", ", l.Colaboradores)</td>
                            <td class="small">@l.Observaciones</td>
                            <td class="text-end"><a asp-area="Labores" asp-controller="Labores" asp-action="Detalle" asp-route-id="@l.Id" class="btn btn-sm btn-outline-secondary">Ver</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="small text-muted mt-2">
                @Model.Labores.Count labor(es) · @Model.Labores.Sum(l => l.HorasTotales).ToString("N2") horas acumuladas
                @if (Model.Labores.Count > 10)
                {
                    <span>· se muestran las 10 más recientes</span>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalDesactivar" tabindex="-1" aria-labelledby="modalDesactivarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Desactivar" method="post">
                <input type="hidden" name="id" value="@terreno.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDesactivarLabel">Desactivar @tipoTexto.ToLower()</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Estás a punto de desactivar <strong>@terreno.Codigo — @terreno.Nombre</strong>.</p>
                    <p class="text-muted small mb-0">
                        Pasará a estado <strong>Inactivo</strong> y dejará de aparecer entre los registros
                        activos, pero su historial se conserva y puedes reactivarl@(g) más adelante cambiando
                        su estado.
                        @if (esFinca)
                        {
                            <span>Mientras esté inactiva no se le podrán agregar lotes nuevos.</span>
                        }
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Sí, desactivar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Eliminar" method="post">
                <input type="hidden" name="id" value="@terreno.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="modalEliminarLabel">Eliminar @tipoTexto.ToLower()</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Estás a punto de eliminar <strong>@terreno.Codigo — @terreno.Nombre</strong>.</p>
                    <p class="text-danger small mb-0">
                        @if (esFinca)
                        {
                            <span>Si la finca tiene lotes, labores, enfermedades o períodos asociados, el sistema no permitirá continuar y deberás usar «Desactivar» para conservar su historial.</span>
                        }
                        else
                        {
                            <span>Si el lote tiene labores, enfermedades o períodos asociados, el sistema no permitirá continuar y deberás usar «Desactivar» para conservar su historial.</span>
                        }
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>
