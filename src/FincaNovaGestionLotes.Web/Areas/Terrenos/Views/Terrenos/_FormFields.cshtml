@model TerrenoFormViewModel

<input type="hidden" asp-for="Tipo" />

<div class="row g-3">
    @if (Model.Tipo == TipoTerreno.Lote)
    {
        <div class="col-md-8">
            <label asp-for="FincaPadreId" class="form-label fw-semibold"></label>
            @if (Model.EsEdicion)
            {
                var texto = Model.FincasPadre.FirstOrDefault(p => p.Id == Model.FincaPadreId)?.Texto ?? "—";
                <input class="form-control" value="@texto" disabled />
                <input type="hidden" asp-for="FincaPadreId" />
                <div class="form-text">Un lote no puede cambiarse de finca.</div>
            }
            else
            {
                <select asp-for="FincaPadreId" class="form-select" id="fincaSelect" required>
                    <option value="">-- Seleccione la finca --</option>
                    @foreach (var f in Model.FincasPadre)
                    {
                        <option value="@f.Id" data-disponible="@f.AreaDisponible.ToString("N2")"
                                data-codigo="@f.SiguienteCodigoLote" data-ubicacion="@f.Ubicacion"
                                selected="@(Model.FincaPadreId == f.Id)">@f.Texto (@f.AreaDisponible.ToString("N2") ha libres)</option>
                    }
                </select>
                <div class="form-text" id="fincaAyuda">Todo lote pertenece a una finca; su área no puede superar el área libre de esa finca.</div>
            }
            <span asp-validation-for="FincaPadreId" class="text-danger"></span>
        </div>
    }

    <div class="col-md-4">
        <label asp-for="Codigo" class="form-label"></label>
        @if (Model.EsEdicion)
        {
            <input class="form-control" value="@Model.Codigo" disabled />
            <input type="hidden" asp-for="Codigo" />
        }
        else if (Model.Tipo == TipoTerreno.Lote)
        {
            <input class="form-control" id="codigoLote" value="Se asigna al elegir la finca" disabled />
            <div class="form-text">Se genera solo a partir del código de la finca.</div>
        }
        else
        {
            <input asp-for="Codigo" class="form-control" maxlength="25" placeholder="Ej. FINCA-01" />
        }
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="AreaHectareas" class="form-label"></label>
        <input asp-for="AreaHectareas" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="AreaHectareas" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="AnioSiembra" class="form-label"></label>
        <input asp-for="AnioSiembra" class="form-control" type="number" min="1900" max="2100" />
        <span asp-validation-for="AnioSiembra" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="VariedadCafe" class="form-label"></label>
        <input asp-for="VariedadCafe" class="form-control" list="variedades" />
        <datalist id="variedades">
            <option value="Caturra" />
            <option value="Catuaí" />
            <option value="Typica" />
            <option value="Bourbon" />
            <option value="Geisha" />
            <option value="Villa Sarchí" />
            <option value="Obatá" />
            <option value="Marsellesa" />
        </datalist>
        <span asp-validation-for="VariedadCafe" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Ubicacion" class="form-label"></label>
        <input asp-for="Ubicacion" class="form-control" placeholder="Ej. Poás, La abuela" />
        <span asp-validation-for="Ubicacion" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Observaciones" class="form-label"></label>
        <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
    </div>
</div>

<script>
    (function () {
        var fincaSelect = document.getElementById('fincaSelect');
        var fincaAyuda = document.getElementById('fincaAyuda');
        if (!fincaSelect || !fincaAyuda) return;
        var codigoLote = document.getElementById('codigoLote');
        var ubicacion = document.getElementById('Ubicacion');
        var textoInicial = fincaAyuda.textContent;
        var ubicacionSugerida = '';

        function actualizarAyuda() {
            var opcion = fincaSelect.options[fincaSelect.selectedIndex];
            var disponible = opcion ? opcion.getAttribute('data-disponible') : null;
            fincaAyuda.textContent = disponible
                ? 'El área del lote no puede superar ' + disponible + ' ha disponibles en esta finca.'
                : textoInicial;

            if (codigoLote) {
                var codigo = opcion ? opcion.getAttribute('data-codigo') : null;
                codigoLote.value = codigo ? codigo : 'Se asigna al elegir la finca';
            }

            if (ubicacion) {
                var nueva = opcion ? (opcion.getAttribute('data-ubicacion') || '') : '';
                if (ubicacion.value === '' || ubicacion.value === ubicacionSugerida) {
                    ubicacion.value = nueva;
                    ubicacionSugerida = nueva;
                }
            }
        }

        fincaSelect.addEventListener('change', actualizarAyuda);
        actualizarAyuda();
    })();
</script>
