@model VentaFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Fecha" class="fn-form-label"></label>
        <input asp-for="Fecha" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="fn-form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Comprador" class="fn-form-label"></label>
        <input asp-for="Comprador" class="fn-form-control" placeholder="Ej. Beneficio Coopedota" />
        <span asp-validation-for="Comprador" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Cantidad" class="fn-form-label"></label>
        <input asp-for="Cantidad" type="number" step="0.01" min="0.01" class="fn-form-control" id="cantidad" />
        <span asp-validation-for="Cantidad" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Unidad" class="fn-form-label"></label>
        <select asp-for="Unidad" class="fn-form-select" asp-items="Html.GetEnumSelectList<UnidadVentaCafe>()"></select>
        <span asp-validation-for="Unidad" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PrecioUnitario" class="fn-form-label"></label>
        <input asp-for="PrecioUnitario" type="number" step="0.01" min="0.01" class="fn-form-control" id="precioUnitario" />
        <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="PeriodoProductivoId" class="fn-form-label"></label>
        <select asp-for="PeriodoProductivoId" class="fn-form-select" asp-items="Model.Periodos">
            <option value="">-- Sin período --</option>
        </select>
        <span asp-validation-for="PeriodoProductivoId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="fn-form-label">Total de la venta</label>
        <div class="fn-form-control fw-bold" id="totalVenta">₡0.00</div>
    </div>

    <div class="col-12">
        <label asp-for="Observaciones" class="fn-form-label"></label>
        <textarea asp-for="Observaciones" class="fn-form-control" rows="2"
                  placeholder="Ej. Entrega en el beneficio, pago al contado."></textarea>
        <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>
</div>
