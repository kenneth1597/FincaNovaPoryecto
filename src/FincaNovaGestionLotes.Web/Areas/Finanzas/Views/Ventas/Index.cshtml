@model VentaFiltroViewModel

@{
    ViewData["Title"] = "Ventas de café";
}

<div class="fn-page-header">
    <div>
        <h1 class="fn-page-title">Ventas de café</h1>
        <p class="fn-page-subtitle">
            Historial de las ventas de café con el comprador, la cantidad y el total de cada una.
        </p>
    </div>
    <a asp-action="Crear" class="fn-btn fn-btn-primary">+ Registrar venta</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success border-0 shadow-sm">@ok</div>
}

<div class="fn-card">
    <div class="fn-card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label asp-for="Desde" class="fn-form-label">Desde</label>
                    <input asp-for="Desde" type="date" class="fn-form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Hasta" class="fn-form-label">Hasta</label>
                    <input asp-for="Hasta" type="date" class="fn-form-control" />
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button type="submit" class="fn-btn fn-btn-primary">Filtrar</button>
                    <a asp-action="Index" class="fn-btn fn-btn-outline">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="fn-card">
    <div class="fn-card-header d-flex justify-content-between align-items-center">
        <h2 class="fn-card-title">Ventas registradas</h2>
        <span class="fn-count">@Model.Paginacion.Total venta(s) · Total vendido ₡@Model.TotalVendido.ToString("N2")</span>
    </div>

    @if (!Model.Resultados.Any())
    {
        <div class="fn-empty">
            <div class="fn-empty-title">No hay ventas registradas.</div>
            <div class="fn-empty-text">
                @(Model.Desde.HasValue || Model.Hasta.HasValue
                    ? "Ninguna venta coincide con el rango de fechas elegido."
                    : "Registra la primera venta de café para empezar a llevar el control de los ingresos.")
            </div>
        </div>
    }
    else
    {
        <div class="fn-card-body">
            <div class="fn-table-wrapper">
                <table class="fn-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Comprador</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Precio unitario</th>
                            <th class="text-end">Total</th>
                            <th>Período</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Resultados)
                        {
                            <tr>
                                <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold">@v.Comprador</td>
                                <td class="text-end">@v.Cantidad.ToString("0.##") @(v.Unidad.ToString().ToLower())</td>
                                <td class="text-end">₡@v.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end fw-bold">₡@v.Total.ToString("N2")</td>
                                <td>@(v.Periodo ?? "—")</td>
                                <td class="text-end">
                                    <a asp-action="Editar" asp-route-id="@v.Id" class="fn-btn fn-btn-outline">Editar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Paginacion" model="Model.Paginacion" />
    }
</div>
