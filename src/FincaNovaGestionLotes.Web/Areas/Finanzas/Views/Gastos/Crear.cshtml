@model GastoFormViewModel

@{
    ViewData["Title"] = "Registrar gasto";
}

<div class="fn-page-header">
    <div>
        <h1 class="fn-page-title">Registrar gasto</h1>
        <p class="fn-page-subtitle">Anota el egreso y, si lo tienes, adjunta el comprobante.</p>
    </div>
    <a asp-action="Index" class="fn-btn fn-btn-outline">Volver</a>
</div>

<div class="fn-card">
    <div class="fn-card-body">
        <form asp-action="Crear" method="post" enctype="multipart/form-data">
            <partial name="_FormFields" model="Model" />

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="fn-btn fn-btn-primary">Registrar gasto</button>
                <a asp-action="Index" class="fn-btn fn-btn-outline">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
