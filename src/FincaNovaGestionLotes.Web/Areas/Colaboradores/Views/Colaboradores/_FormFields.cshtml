@model ColaboradorFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nombre" class="fn-form-label"></label>
        <input asp-for="Nombre" class="fn-form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Identificacion" class="fn-form-label"></label>
        <input asp-for="Identificacion" class="fn-form-control" placeholder="Ej. 1-2345-6789" />
        <span asp-validation-for="Identificacion" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Telefono" class="fn-form-label"></label>
        <input asp-for="Telefono" class="fn-form-control" placeholder="Ej. 8888-8888" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Cargo" class="fn-form-label"></label>
        <input asp-for="Cargo" class="fn-form-control" list="cargos" />
        <datalist id="cargos">
            <option value="Peón agrícola" />
            <option value="Recolector" />
            <option value="Capataz" />
            <option value="Operario de atomización" />
        </datalist>
        <span asp-validation-for="Cargo" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="TarifaJornada" class="fn-form-label"></label>
        <input asp-for="TarifaJornada" type="number" step="0.01" min="0.01" class="fn-form-control" />
        <span asp-validation-for="TarifaJornada" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="UsuarioId" class="fn-form-label"></label>
        <select asp-for="UsuarioId" class="fn-form-select">
            <option value="">-- Sin usuario (no ingresa al sistema) --</option>
            @foreach (var u in Model.Usuarios)
            {
                <option value="@u.Id">@u.Texto</option>
            }
        </select>
        <div class="form-text">Vincúlalo para que el colaborador pueda ver sus labores asignadas, registrar horas y cerrarlas.</div>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>
</div>
