<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FincaNova
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg fn-navbar">

            <div class="container-fluid px-4">

                <!-- LOGO -->

                <a class="navbar-brand"
                   asp-area="Lotes"
                   asp-controller="Lotes"
                   asp-action="Index">

                    <span class="fn-logo">
                        ●
                    </span>

                    <span>
                        FincaNova · Lotes
                    </span>

                </a>


                <!-- BOTÓN MÓVIL -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarFincaNova">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- MENÚ -->

                <div class="collapse navbar-collapse"
                     id="navbarFincaNova">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <!-- LOTES -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area="Lotes"
                               asp-controller="Lotes"
                               asp-action="Index">

                                Lotes y micro lotes

                            </a>

                        </li>


                        <!-- ENFERMEDADES -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area="Enfermedades"
                               asp-controller="Enfermedades"
                               asp-action="Index">

                                Enfermedades

                            </a>

                        </li>


                        <!-- ALERTAS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area="Enfermedades"
                               asp-controller="Enfermedades"
                               asp-action="Alertas">

                                Alertas

                            </a>

                        </li>


                        <!-- PANEL -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area="Lotes"
                               asp-controller="Lotes"
                               asp-action="Panel">

                                Panel por estado

                            </a>

                        </li>


                        <!-- PERIODOS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area="Produccion"
                               asp-controller="Periodos"
                               asp-action="Index">

                                Períodos productivos

                            </a>

                        </li>


                        <!-- BITÁCORA -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area="Bitacora"
                               asp-controller="Bitacora"
                               asp-action="Index">

                                Bitácora

                            </a>

                        </li>
                    </ul>
                </div>
                @using Microsoft.AspNetCore.Http

@{
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
    var usuarioRol = Context.Session.GetString("UsuarioRol");
}

<div class="collapse navbar-collapse" id="navbarMain">

    
    <!-- Menú Derecho: Saludo, Mi Perfil y Cerrar Sesión -->
    <ul class="navbar-nav ms-auto align-items-center">
        @if (!string.IsNullOrEmpty(usuarioNombre))
        {
                            <ul class="navbar-nav me-auto">
                                @if (usuarioRol == "Administrador" || usuarioRol == "Dueño")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Usuarios" asp-action="Index">
                                            <i class="bi bi-people-fill me-1"></i>Gestión de Usuarios
                                        </a>
                                    </li>
                                }
                            </ul>

            <!-- Saludo al usuario -->
            <li class="nav-item me-2">
                <span class="nav-link text-white fw-bold">
                    <i class="bi bi-person-circle me-1"></i>Hola, @usuarioNombre
                </span>
            </li>

            <!-- Botón Mi Perfil -->
            <li class="nav-item me-2">
                <a class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Account" asp-action="Perfil">
                    <i class="bi bi-person-gear"></i>
                    <span>Mi Perfil</span>
                </a>
            </li>

            <!-- Botón Cerrar Sesión -->
            <li class="nav-item">
                <a class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Cerrar Sesión</span>
                </a>
            </li>
        }
        else
        {
            <!-- Iniciar Sesión (Si no hay sesión activa) -->
            <li class="nav-item">
                <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
                </a>
            </li>
        }
    </ul>
</div>
                    
            </div>

        </nav>

    </header>


    <!-- CONTENIDO -->

    <main class="fn-main">

        @RenderBody()

    </main>


    <!-- FOOTER -->

    <footer class="fn-footer">

        <div class="container">

            FincaNova · Gestión de Lotes y Micro lotes

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>