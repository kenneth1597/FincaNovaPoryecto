@model int?
@{
    // Mismo parámetro de siempre (ancho base); el dibujo es cuadrado y algo mayor.
    var size = (Model ?? 24) * 13 / 10;
    // Ids únicos: el ícono aparece varias veces en la misma página.
    var id = Guid.NewGuid().ToString("N")[..8];
}
<svg width="@size" height="@size" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Grano de café" class="fn-bean-icon">
    <defs>
        <radialGradient id="grano-@id" cx="38%" cy="30%" r="75%">
            <stop offset="0" stop-color="#A9744F" />
            <stop offset=".55" stop-color="#6D4127" />
            <stop offset="1" stop-color="#3E2416" />
        </radialGradient>
        <linearGradient id="hoja-@id" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8DB35E" />
            <stop offset="1" stop-color="#4C6830" />
        </linearGradient>
    </defs>

    @* Hojas detrás del grano *@
    <path d="M24 13 C27 4, 36 3, 38 4 C38 12, 32 18, 24 15 Z" fill="url(#hoja-@id)" />
    <path d="M25 14 C29 10, 33 7, 37 5" fill="none" stroke="#E6EBD8" stroke-width=".9" stroke-linecap="round" opacity=".8" />
    <path d="M9 31 C3 30, 1 24, 2 21 C8 20, 13 24, 12 30 Z" fill="url(#hoja-@id)" opacity=".9" />
    <path d="M11 29.5 C8 26.5, 5 24, 3 22" fill="none" stroke="#E6EBD8" stroke-width=".8" stroke-linecap="round" opacity=".8" />

    @* Sombra y grano *@
    <ellipse cx="21" cy="36" rx="9" ry="1.8" fill="#2C1F17" opacity=".18" />
    <g transform="rotate(-22 20 20)">
        <ellipse cx="20" cy="20" rx="10.5" ry="14.5" fill="url(#grano-@id)" />
        <ellipse cx="16.2" cy="13.5" rx="3.2" ry="5.2" fill="#FFFFFF" opacity=".16" />
        <path d="M20 6.2 C15.5 11, 24 15.5, 20 20 C16 24.5, 24.5 29, 20 33.8"
              fill="none" stroke="#F3E3C8" stroke-width="2.1" stroke-linecap="round" />
        <path d="M20.8 6.5 C16.6 11, 24.8 15.5, 20.8 20 C16.8 24.5, 25.2 29, 20.8 33.5"
              fill="none" stroke="#2C1A10" stroke-width=".7" stroke-linecap="round" opacity=".35" />
    </g>
</svg>
