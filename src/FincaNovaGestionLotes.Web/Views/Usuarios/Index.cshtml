@using FincaNovaGestionLotes.Web.Domain.Usuarios;
@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var usuarioActualId = Context.Session.GetInt32("UsuarioId");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Usuarios</h2>
    <a asp-action="Create" class="btn btn-success">+ Crear Nuevo Usuario</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Creado Por</th>
                        <th>Última Modificación</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Id</td>
                            <td class="fw-bold">@u.Nombre</td>
                            <td>@u.Email</td>
                            <td>
                                <span class="badge @(u.Rol == "Administrador" || u.Rol == "Dueño" ? "bg-primary" : "bg-secondary")">
                                    @u.Rol
                                </span>
                            </td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">
                                    @(u.CreadoPor ?? "Sistema") <br />
                                    @u.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </td>
                            <td>
                                @if (u.FechaModificacion.HasValue)
                                {
                                    <small class="text-muted">
                                        @(u.ModificadoPor ?? "Desc") <br />
                                        @u.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted">-</small>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group gap-1">
                                    <!-- Editar -->
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                        Editar
                                    </a>

                                    @if (u.Id != usuarioActualId)
                                    {
                                        <!-- Alternar Estado: Desactivar / Reactivar -->
                                        <form asp-action="ToggleEstado" asp-route-id="@u.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (u.Activo)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Desactivar usuario">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivar usuario">
                                                    Activar
                                                </button>
                                            }
                                        </form>

                                        <!-- Borrar de la BD (Abre Modal) -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteHardModal-@u.Id" title="Eliminar de la Base de Datos">
                                            Eliminar BD
                                        </button>
                                    }
                                </div>

                                <!-- Modal de Confirmación para Borrado Definitivo -->
                                @if (u.Id != usuarioActualId)
                                {
                                    <div class="modal fade" id="deleteHardModal-@u.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title">Eliminar de la Base de Datos</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>¿Estás seguro de que deseas eliminar permanentemente al usuario <strong>@u.Nombre</strong> de la base de datos?</p>
                                                    <div class="alert alert-warning mb-0 small">
                                                        <strong>Nota:</strong> Esta acción borrará el registro por completo de la base de datos. Si solo deseas quitarle el acceso, te recomendamos usar la opción <strong>Desactivar</strong>.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Confirmar Eliminar</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>