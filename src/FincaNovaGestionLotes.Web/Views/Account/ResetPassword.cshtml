@model FincaNovaGestionLotes.Web.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="container mt-5" style="max-width: 450px;">
    <h2 class="text-center mb-4">Restablecer Contraseña</h2>

    <!-- Mostrar errores de validación generales si el token expiró o es inválido -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-action="ResetPassword" method="post">
        <!-- ⚠️ CAMPOS CLAVE: Si faltan estos hidden, el POST siempre fallará -->
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div class="form-group mb-3">
            <label asp-for="NewPassword" class="form-label">Nueva Contraseña</label>
            <input asp-for="NewPassword" class="form-control" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirmar Nueva Contraseña</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Cambiar Contraseña</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}