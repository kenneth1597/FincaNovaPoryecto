@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-4">
                <div class="card-body">
                    <div class="mb-3 text-danger">
                        <i class="bi bi-shield-slash-fill display-1"></i>
                    </div>
                    <h2 class="fw-bold text-danger mb-3">Acceso Denegado</h2>
                    <p class="text-muted mb-4">
                        No posees los permisos requeridos para acceder a esta sección de la aplicación.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house-door me-1"></i> Ir al Inicio
                        </a>
                        <a asp-controller="Account" asp-action="Perfil" class="btn btn-outline-secondary">
                            <i class="bi bi-person-circle me-1"></i> Ir a Mi Perfil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>