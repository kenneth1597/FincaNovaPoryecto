@* Panel café de las pantallas de acceso (login, recuperar y restablecer contraseña). *@
@model (string Titulo, string Resaltado, string Texto, bool MostrarPuntos)

<aside class="fn-login-marca">
    <svg class="fn-login-patron" aria-hidden="true">
        <defs>
            <pattern id="patronCafe" width="120" height="120" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
                <ellipse cx="30" cy="30" rx="9" ry="13" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M30 18c-4 6 4 9 0 15s4 9 0 13" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M85 80c12-16 30-14 30-14s-2 18-18 24c-7 3-12-2-12-10Z" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M86 88l26-20" fill="none" stroke="currentColor" stroke-width="1.2" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#patronCafe)" />
    </svg>

    <div class="fn-login-marca-contenido">
        <div class="fn-login-logo">
            <span class="fn-login-logo-icono">
                <partial name="_CoffeeBeanIcon" model="30" />
            </span>
            <span>
                <strong>FincaNova</strong>
                <small>Café Chaperno · Poás</small>
            </span>
        </div>

        <div class="fn-login-mensaje">
            <h1>@Model.Titulo<br /><span>@Model.Resaltado</span></h1>
            <p>@Model.Texto</p>
        </div>

        @if (Model.MostrarPuntos)
        {
            <ul class="fn-login-puntos">
                <li>
                    <span class="fn-login-punto-icono">
                        <svg viewBox="0 0 24 24"><path d="M12 21v-9" /><path d="M12 12C12 8 9.5 5.5 5 5.5c0 4.2 2.8 6.5 7 6.5Z" /><path d="M12 14c0-3.2 2.4-5.5 7-5.5 0 3.6-2.6 5.5-7 5.5Z" /></svg>
                    </span>
                    <span><strong>Fincas y lotes</strong> con su historial completo</span>
                </li>
                <li>
                    <span class="fn-login-punto-icono">
                        <svg viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="17" rx="2" /><path d="M9 4h6v3H9z" /><path d="M9.5 13.5l2 2 3.5-4" /></svg>
                    </span>
                    <span><strong>Labores revisadas</strong> antes de cerrarse</span>
                </li>
                <li>
                    <span class="fn-login-punto-icono">
                        <svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4Z" /><path d="M3 7v10l9 4 9-4V7" /><path d="M12 11v10" /></svg>
                    </span>
                    <span><strong>Inventario</strong> con alertas de stock</span>
                </li>
            </ul>
        }
        else
        {
            <ul class="fn-login-puntos">
                <li>
                    <span class="fn-login-punto-icono">
                        <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3Z" /><path d="M9 12l2 2 4-4" /></svg>
                    </span>
                    <span><strong>Enlace seguro</strong> enviado solo a su correo</span>
                </li>
                <li>
                    <span class="fn-login-punto-icono">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2.5 2" /><path d="M9 2h6" /></svg>
                    </span>
                    <span><strong>Válido por pocos minutos</strong> para su protección</span>
                </li>
                <li>
                    <span class="fn-login-punto-icono">
                        <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M17 11v6M14 14h6" /></svg>
                    </span>
                    <span><strong>¿Sin acceso?</strong> El administrador puede ayudarle</span>
                </li>
            </ul>
        }

        <div class="fn-login-pie">Poás, Alajuela · Costa Rica</div>
    </div>
</aside>
