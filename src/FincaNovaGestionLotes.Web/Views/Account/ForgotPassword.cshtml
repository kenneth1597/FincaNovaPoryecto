@model FincaNovaGestionLotes.Web.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar Contraseña";
    ViewData["PantallaCompleta"] = true;
}

<div class="fn-login">

    <partial name="_PanelAcceso" model='("¿Olvidó su contraseña?", "Recupere el acceso en un momento.", "Le enviaremos un enlace a su correo para que cree una contraseña nueva.", false)' />

    <main class="fn-login-panel">
        <div class="fn-login-formulario">
            <span class="fn-login-insignia" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4" /><path d="M10.8 12.2L20 3M17 6l3 3M15 8l2 2" /></svg>
            </span>
            <h2>Recuperar contraseña</h2>
            <p class="fn-login-sub">Escriba el correo asociado a su cuenta y le enviaremos un enlace para restablecerla.</p>

            @* El login redirige aquí con ErrorMessage cuando la cuenta quedó bloqueada por intentos fallidos. *@
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="fn-login-error">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="fn-login-error"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <div class="fn-login-campo">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6 8.5-6" /></svg>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="fn-btn fn-btn-primary fn-login-boton">
                    Enviar enlace
                    <svg viewBox="0 0 24 24"><path d="M4 12l16-8-6 16-2.5-6.5L4 12Z" /></svg>
                </button>
            </form>

            <a asp-action="Login" class="fn-login-volver">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                Volver al inicio de sesión
            </a>

            <div class="fn-login-nota">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8v.5" /></svg>
                Si no recibe el correo en unos minutos, revise la carpeta de spam o pida ayuda al administrador de la finca.
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
